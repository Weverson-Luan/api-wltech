# =============================================================================
# DATABASE_URL — atenção ao host e à porta
# =============================================================================
#
# Comandos no Mac/host (pnpm db:migrate, db:seed, db:studio, DBeaver):
#   host: localhost
#   porta: mesma de POSTGRES_PORT abaixo (padrão 5433, evita conflito com 5432)
#
# API rodando dentro do Docker:
#   o docker-compose.yml sobrescreve para @postgres:5432 (rede interna).
#
# Produção (VPS):
#   use @postgres no .env.production (ver .env.production.example).
#
POSTGRES_PORT=5433

POSTGRES_USER=wltech
POSTGRES_PASSWORD=wltech
POSTGRES_DB=wltech

# Senha aqui deve ser IGUAL a POSTGRES_PASSWORD
DATABASE_URL=postgresql://wltech:wltech@localhost:5433/wltech
API_PORT=3333
PORT=3333
HOST=0.0.0.0

# Autenticação JWT
JWT_SECRET=altere-para-um-segredo-forte-em-producao
JWT_EXPIRES_IN=7d
