# Copie para .env.production na VPS (nunca versione o arquivo real).
# DATABASE_URL usa o hostname interno do serviço Docker "postgres".

NODE_ENV=production

POSTGRES_USER=wltech
POSTGRES_PASSWORD=altere-para-senha-forte
POSTGRES_DB=wltech

DATABASE_URL=postgresql://wltech:altere-para-senha-forte@postgres:5432/wltech

PORT=3333
HOST=0.0.0.0

# Porta só em 127.0.0.1 na VPS (Nginx faz proxy em 80/443 — ver docs/DEPLOY.md Parte 8)
API_PORT=13333

JWT_SECRET=altere-para-um-segredo-forte-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=7d

# Imagem publicada pelo GitHub Actions (ajuste org/usuário se necessário)
API_IMAGE=ghcr.io/weverson-luan/api-wltech:latest
